# ---- LLM: Groq (recommended by the hackathon; fast + generous free tier) ----
# Get a free key at https://groq.com/  (Console -> API Keys)
GROQ_API_KEY=
# Recommended models: openai/gpt-oss-120b  or  qwen/qwen3-32b
GROQ_MODEL=openai/gpt-oss-120b

# ---- Memory: Hindsight (required hackathon technology) ----
# MEMORY_BACKEND: auto | hindsight | local
#   auto      = use Hindsight if HINDSIGHT_API_URL is set, else local fallback
#   hindsight = require Hindsight (errors if not reachable)
#   local     = always use the offline local store (no external services)
MEMORY_BACKEND=auto

# Hindsight Cloud (https://ui.hindsight.vectorize.io) or self-hosted open source.
# Promo code MEMHACK99 = $50 free credits (add in billing after registering).
HINDSIGHT_API_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_UI_URL=
HINDSIGHT_BANK_ID=incident-commander
